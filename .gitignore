*.egg
*.pdb
*.log

# Virtual envs & local configs
.venv/
.env
.ipynb_checkpoints/
.spyproject/

# Streamlit
.streamlit/secrets.toml

# Generated stuff (don’t version)
artifacts/
logs/
run_logs/
_backup_*/
old/

# Validation outputs (keep YAML cards, ignore csv/png)
validation/**/*.csv
validation/**/*.png
validation/summary.csv

# OS/Editors
.DS_Store
Thumbs.db
.vscode/

# project scripts are versioned
# scripts/

# validation artifacts folder (keep specs elsewhere)
# validation/

# Cleanup artifacts
_cleanup_*.txt
_cleanup_*.zip
_archive_*.zip
repo_tree.txt

# Preview lists from cleanup
_preview_*.txt
.venv/

**/*.json
**/*.csv
# Fleet data is an INPUT, not an output: it must be tracked or the model
# silently falls back to a 2-row toy fleet. The loader prefers
# <DATA_DIR>/plants.csv and falls back to datasets/steel/plants.csv.
!datasets/steel/plants.csv
!datasets/steel/*/plants.csv
**/*.png
**/*.log
